{
  "id": "./",
  "name": "Velonify Hub",
  "short_name": "Velonify Hub",
  "description": "Interne Plattform von Velonify",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": "focus-existing" },
  "background_color": "#f2eff0",
  "theme_color": "#f2eff0",
  "icons": [
    { "src": "app/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "app/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "app/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "app/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Mein Tag", "url": "./#/crm", "icons": [{ "src": "app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Eingang", "url": "./#/eingang", "icons": [{ "src": "app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Meine Aufgaben", "url": "./#/todo/meine", "icons": [{ "src": "app/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pipeline", "url": "./#/crm/pipeline", "icons": [{ "src": "app/icon-192.png", "sizes": "192x192" }] }
  ]
}
