# Kopieren nach .env.local und ausfüllen. Ohne diese Werte startet das CRM im Demo-Modus mit Beispieldaten.
# .env.local wird nie ins Repo hochgeladen.

# OAuth-Client-ID aus der Google Cloud Console (Typ „Webanwendung“)
VITE_GOOGLE_CLIENT_ID=

# ID des Google Sheets „CRM-Datenbank“ – der Teil zwischen /d/ und /edit in der Sheet-URL
VITE_SPREADSHEET_ID=

# Nur Google-Konten dieser Domain dürfen sich anmelden
VITE_ALLOWED_DOMAIN=velonify.de

# Adresse der Cloud Function des Contact Generators (functions/contact-generator)
VITE_CONTACT_GENERATOR_URL=https://europe-west3-velonify-crm.cloudfunctions.net/contact-generator
