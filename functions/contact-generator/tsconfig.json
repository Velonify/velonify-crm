{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "../gemeinsam"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "../gemeinsam/**/*.test.ts"
  ]
}
