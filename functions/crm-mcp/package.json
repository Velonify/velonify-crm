{
  "name": "crm-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "Remote-MCP-Server für das Velonify-CRM: Claude liest und schreibt das CRM mit dem Google-Konto der Person, über dieselben Regeln wie der Hub.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
